# POZOR: docker na JODA je snap - vidi jen /home a /media (removable-media),
# /pool ani /tmp mountovat NEJDE.
# Produkce bezi na velkem disku (17 T); /home je jen 24 G systemovy disk.
DATA_DIR=/media/storage/ugc

# Kam NAS posila /generate a reroll (ugc-pipeline ze spark/).
# Prazdna hodnota = appka dostane "SPARK_GENERATE_URL not configured".
# ugc-pipeline na Sparku (monorepo spark/):
SPARK_GENERATE_URL=http://192.168.88.66:8092/ugc/generate
SPARK_CF_CLIENT_ID=
SPARK_CF_CLIENT_SECRET=

# --- fantasy characters (docs/FANTASYCHARACTER_PLAN.md) ---
# vlastni scope pro fantasy_character appku; prazdne = /v1/fc/ otevrene (LAN)
FC_API_KEYS=
# ComfyUI na Sparku pro kroky preprocess/mesh/rig; prazdne = tyhle kroky selzou
FC_COMFY_URL=
# turntable preview: thumb (vychozi, 1 snimek) | full (15 min na JODA) | none
FC_PREVIEW=thumb
# auto = oba rigy, vybere se ten, co se pri prvnim klipu min trha; template =
# jen sablona v Blenderu na JODA; comfy = jen MIA na Sparku (plan 13)
FC_RIG=auto
# jak dlouho auto ceka na MIA ve sdilene fronte ComfyUI, pak zustane sablona
FC_RIG_MIA_TIMEOUT=300
# Nad kolik stupnu odchylky klidove pozy od Mixamo kostry se rig nebere (plan 16)
FC_RIG_REST_OFFSET_MAX=10
