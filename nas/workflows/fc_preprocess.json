{
  "1": {
    "class_type": "LoadImage",
    "_meta": {"title": "FC_INPUT_IMAGE"},
    "inputs": {"image": "placeholder.png", "upload": "image"}
  },
  "2": {
    "class_type": "RMBG",
    "_meta": {"title": "FC_RMBG"},
    "inputs": {
      "image": ["1", 0],
      "model": "RMBG-2.0",
      "sensitivity": 1.0,
      "process_res": 1024,
      "mask_blur": 0,
      "mask_offset": 0,
      "invert_output": false,
      "refine_foreground": true,
      "background": "Alpha"
    }
  },
  "3": {
    "class_type": "SaveImage",
    "_meta": {"title": "FC_OUTPUT"},
    "inputs": {"images": ["2", 0], "filename_prefix": "fc/apose"}
  }
}
