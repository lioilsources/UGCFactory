<?xml version="1.0" encoding="utf-8"?>
<!-- ugc-api bezi po tailnetu bez TLS. Cleartext povolujeme adresne
     jen pro nej, ne globalne. Pres ugc.ol1n.com jede HTTPS normalne. -->
<network-security-config>
    <!-- model_viewer_plus na mobilu spousti lokalni HTTP proxy na 127.0.0.1
         a nacita ji ve WebView; bez povoleneho localhostu zustane 3D
         prohlizec prazdny (Android 9+ zakazuje cleartext ve vychozim stavu). -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <!-- Tailscale MagicDNS hosts (<host>.<tailnet>.ts.net); the traffic is
             encrypted by WireGuard anyway. A LAN address can be added locally. -->
        <domain includeSubdomains="true">ts.net</domain>
    </domain-config>
</network-security-config>
